NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/video-generator
# Comma-separated list of browser origins allowed to call the API (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173
# Public URL of this server; used to build absolute signed links for local storage
# PUBLIC_BASE_URL=https://clipforge.example.com

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN=1h
JWT_ISSUER=video-generator
BCRYPT_SALT_ROUNDS=12

# Storage: "local" writes to LOCAL_STORAGE_DIR; "s3" works with AWS S3 or Cloudflare R2
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# S3_BUCKET=clipforge
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# Inputs
UPLOAD_MAX_BYTES=209715200
MAX_VIDEO_SECONDS=180
URL_IMPORT_TIMEOUT_MS=60000

# FFmpeg (bundled static binaries are used when unset)
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_TIMEOUT_MS=300000

# Worker / queue
# Run the worker inside the API process (single-service deploys). Otherwise run `npm run worker`.
EMBEDDED_WORKER=false
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
JOB_LOCK_MS=60000
MAX_ATTEMPTS=3
MAX_ACTIVE_JOBS_PER_USER=3
OUTPUT_TTL_DAYS=7
